# ============================================================
# RailGuard AI – .gitignore
# ============================================================

# ── Environment / Secrets ────────────────────────────────────
.env
*.env
*.env.local

# ── Java / Maven ─────────────────────────────────────────────
backend/railguard/target/
*.class
*.jar
*.war
*.ear
*.nar
backend/railguard/.mvn/wrapper/maven-wrapper.jar
hs_err_pid*

# ── Python / AI Service ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyd
*.pyo
.Python
ai-service/.venv/
ai-service/venv/
ai-service/env/
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── YOLO / Models ────────────────────────────────────────────
ai-service/models/*.pt
ai-service/models/*.onnx
ai-service/models/*.pkl
runs/
*.weights

# ── Node.js (frontend tooling if added later) ────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ── IDE / OS ─────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
log/

# ── Database ─────────────────────────────────────────────────
*.sql.bak
*.db
database/*.bak

# ── Dataset (large files) ────────────────────────────────────
dataset/
*.zip
railguard_v3_backup/
scratch/
backend/railguard/uploads/
.venv/
venv/
*.pt

# ── Temporary ────────────────────────────────────────────────
tmp/
temp/
.tmp/

# ── Backend zip (Initializr download) ────────────────────────
backend/*.zip
