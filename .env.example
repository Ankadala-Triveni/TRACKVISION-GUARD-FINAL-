# ============================================================
# RailGuard AI – Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_NAME=RailGuard AI
APP_VERSION=1.0.0

# ── Spring Boot Backend ──────────────────────────────────────
SPRING_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/railguard_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here
SPRING_JPA_DDL_AUTO=update

# ── FastAPI AI Service ───────────────────────────────────────
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# ── MySQL ────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=railguard_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password_here

# ── JWT / Security (Phase 2+) ────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# ── Google OAuth 2.0 Web Client ID ────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# ── YOLO / AI Model (Phase 2+) ──────────────────────────────
YOLO_MODEL_PATH=ai-service/models/yolo11_railguard.pt
YOLO_CONFIDENCE_THRESHOLD=0.5

# ── Email / Notifications (Phase 2+) ────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
